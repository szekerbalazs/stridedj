# StrideDJ configuration. Copy to `.env` (git-ignored) and fill in. Step-by-step guide: docs/SETUP.md
# Never paste these values into a chat (Telegram or an AI assistant). `stridedj doctor` checks them without printing them.

# ── App ─────────────────────────────────────────────────────────────
STRIDEDJ_RUN_SOURCE=demo                 # demo | garmin | intervals_icu
STRIDEDJ_DATA_DIR=data                   # SQLite DB, caches, traces (git-ignored)
STRIDEDJ_LOG_LEVEL=INFO

# ── OpenAI (docs/SETUP.md §1) ──────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── Telegram (docs/SETUP.md §2) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=               # comma-separated numeric user IDs, e.g. 123456789

# ── Spotify (docs/SETUP.md §3) ─────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_RUNNING_PLAYLIST_IDS=            # comma-separated playlist IDs you OWN
SPOTIFY_REFRESH_TOKEN=                   # written by `stridedj auth spotify`

# ── Google Calendar (docs/SETUP.md §4) ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary               # where run events are created (recommended: a dedicated "Runs" calendar)
GOOGLE_BUSY_CALENDAR_IDS=primary         # comma-separated calendars checked for free/busy
GOOGLE_REFRESH_TOKEN=                    # written by `stridedj auth google`

# ── Garmin (docs/SETUP.md §5) ──────────────────────────────────────
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=~/.garminconnect        # garminconnect's own token store (0600); the one secret not kept in this file

# ── Plan B: intervals.icu (only if the Garmin login fails) ─────────
INTERVALS_ICU_ATHLETE_ID=
INTERVALS_ICU_API_KEY=

# ── Your physiology (docs/SETUP.md §5) ─────────────────────────────
ATHLETE_HR_ZONE_UPPER_BOUNDS=            # upper bounds (bpm, exclusive) of Z1..Z4 as on your watch, e.g. 125,145,160,175
ATHLETE_MAX_HR=
ATHLETE_TIMEZONE=Europe/Zurich
