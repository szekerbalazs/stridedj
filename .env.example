# ─────────────────────────────────────────────────────────────────────────────
# StrideDJ configuration. `make setup` copies this file to .env (git-ignored).
# Step-by-step guide for every value: docs/SETUP.md
# Never paste these values into a chat. `make doctor` checks them without printing them.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
STRIDEDJ_RUN_SOURCE=demo                 # demo | garmin | intervals_icu
STRIDEDJ_DATA_DIR=data                   # SQLite DB, caches, transcripts (git-ignored)
STRIDEDJ_LOG_LEVEL=INFO
ATHLETE_TIMEZONE=Europe/Zurich           # IANA timezone used for "tonight", "tomorrow morning", ...

# ── OpenAI (SETUP.md §1) - required, also for the demo ───────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna                  # cheap default; compare others with the evals
OPENAI_REASONING_EFFORT=low              # none | low | medium | high

# ── Telegram (SETUP.md §2) ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=               # comma-separated numeric user ids

# ── Spotify (SETUP.md §3) ────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_RUNNING_PLAYLIST_IDS=            # comma-separated ids of playlists you OWN
SPOTIFY_REFRESH_TOKEN=                   # written by `stridedj auth spotify`

# ── Google Calendar (SETUP.md §4) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary               # where runs are created (recommended: a dedicated "Runs" calendar)
GOOGLE_BUSY_CALENDAR_IDS=primary         # comma-separated calendars checked for availability
GOOGLE_REFRESH_TOKEN=                    # written by `stridedj auth google`

# ── Garmin (SETUP.md §5) - HR zones are read from Garmin Connect ─────────────
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKEN_DIR=~/.garminconnect        # garminconnect's own session store (0600)

# ── Plan B: intervals.icu (only if the Garmin login fails) ───────────────────
INTERVALS_ICU_ATHLETE_ID=
INTERVALS_ICU_API_KEY=
